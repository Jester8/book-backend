# Port the HTTP server listens on. Render and Fly inject their own value.
PORT=3000
# Auth0 tenant URL, with a trailing slash.
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/
# Identifier of the Auth0 API. Must match VITE_AUTH0_AUDIENCE in the frontend.
AUTH0_AUDIENCE=https://book-admin
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Path to the SQLite database file, relative to the project root.
DATABASE_PATH=data/books.sqlite
